# 统一文本文件行尾规范，避免 Windows/WSL 环境产生 CRLF/LF 伪差异。
# Git 索引内始终存 LF；检出时按扩展名决定行尾。
* text=auto

# 代码与文档统一 LF
*.py  text eol=lf
*.md  text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.js  text eol=lf
*.css text eol=lf
*.sh  text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows 脚本保持 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不处理
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  binary
*.pdf  binary
*.xlsx binary
*.docx binary
*.zip  binary
*.ttf  binary
*.ttc  binary
*.pyc  binary
